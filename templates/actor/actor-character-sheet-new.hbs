{{!-- SW25-RU new character sheet (redesign, layer 1). Generated from actor-character-sheet.hbs:
     roll buttons, form fields and tab bodies are carried over verbatim so SW25ActorSheet handlers keep working.
     Fellow mode (system.toFellow) is intentionally not supported here. --}}
{{#*inline "nqty"}}<li class="item n-qty" data-item-id="{{item._id}}">{{#if label}}<span class="n-qty-name">{{item.name}}</span>{{/if}}{{#if @root.isOwner}}<a class="quantity-button" data-action="decrease" data-property="item.system.quantity"><i class="fas fa-minus"></i></a>{{/if}}<input class="qt-change" type="text" name="quantityInput" value="{{item.system.quantity}}" data-dtype="Number"/>{{#if showmax}}{{#if item.system.qmax}}<span class="n-qty-max">/ {{item.system.qmax}}</span>{{/if}}{{/if}}{{#if @root.isOwner}}<a class="quantity-button" data-action="increase" data-property="item.system.quantity"><i class="fas fa-plus"></i></a>{{#if @root.system.isEdit}}<a class="item-control item-edit"><i class="fas fa-edit"></i></a><a class="item-control item-delete"><i class="fas fa-trash"></i></a>{{/if}}{{/if}}</li>{{/inline}}
{{#*inline "nrow"}}
<li class="item n-row{{#if spell}} spell{{/if}}" data-item-id="{{item._id}}">
  <div class="n-row-main">
    <a class="rollable n-row-img" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="30" height="30"/></a>
    <div class="n-row-text">
      <h4 class="{{#if spell}}spell-label{{else}}item-label{{/if}}">{{#if spell}}{{#if item.system.level}}<span class="n-lv">{{item.system.level}}</span>{{/if}}{{/if}}<span class="n-marks">{{> "systems/sw25-ru/templates/helper/action-marks.hbs"}}</span>{{item.name}}</h4>
      <div class="n-row-meta">{{#if item.system.mpcost}}<span class="mpcost n-tag n-tag-mp" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">{{localize "SW25.Mp"}} {{item.system.mpcost}}</span>{{/if}}{{#if item.system.hpcost}}<span class="hpcost n-tag n-tag-hp" data-cost="{{item.system.hpcost}}" data-max="{{item.system.maxhpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">{{localize "SW25.Hp"}} {{item.system.hpcost}}</span>{{/if}}{{#if (eq item.type "tactics")}}{{#if (eq item.system.type "drum")}}<span class="n-tag">{{item.system.linename}}</span>{{/if}}{{#if (eq item.system.type "camp")}}{{#if item.system.cond}}<span class="n-tag">{{item.system.cond}}</span>{{/if}}{{/if}}{{#if item.system.get}}<span class="tacspowerget n-tag n-tag-get" data-tooltip="{{localize "SW25.Item.Tactics.Get"}}">{{item.system.get}}</span>{{/if}}{{#if item.system.cost}}<span class="tacspowercost n-tag n-tag-cost" data-tooltip="{{localize "SW25.Cost"}}">{{item.system.cost}}</span>{{/if}}{{/if}}{{#if (eq item.type "phasearea")}}<span class="n-tag n-tag-qi">{{item.system.typename}}: {{item.system.mincost}}{{#unless (eq item.system.maxcost 0)}}–{{item.system.maxcost}}{{/unless}}</span>{{/if}}{{#if (eq item.type "alchemytech")}}{{#unless (eq item.system.red 0)}}<span class="n-tag n-card-red">{{localize "SW25.Item.Alchemytech.Red"}} {{item.system.red}}</span>{{/unless}}{{#unless (eq item.system.green 0)}}<span class="n-tag n-card-green">{{localize "SW25.Item.Alchemytech.Green"}} {{item.system.green}}</span>{{/unless}}{{#unless (eq item.system.black 0)}}<span class="n-tag n-card-black">{{localize "SW25.Item.Alchemytech.Black"}} {{item.system.black}}</span>{{/unless}}{{#unless (eq item.system.white 0)}}<span class="n-tag n-card-white">{{localize "SW25.Item.Alchemytech.White"}} {{item.system.white}}</span>{{/unless}}{{#unless (eq item.system.gold 0)}}<span class="n-tag n-card-gold">{{localize "SW25.Item.Alchemytech.Gold"}} {{item.system.gold}}</span>{{/unless}}{{/if}}{{#if (eq item.type "magicalsong")}}{{#if (eq item.system.type "song")}}<span class="notesget n-tag n-tag-get">{{#unless (eq item.system.upget 0)}}<i class="fa-solid fa-arrow-turn-up"></i>{{item.system.upget}}{{/unless}}{{#unless (eq item.system.downget 0)}}<i class="fa-solid fa-arrow-turn-down"></i>{{item.system.downget}}{{/unless}}{{#unless (eq item.system.charmget 0)}}<i class="fa-regular fa-heart"></i>{{item.system.charmget}}{{/unless}}</span><span class="notesaddget n-tag">{{#unless (eq item.system.upadd 0)}}<i class="fa-solid fa-arrow-turn-up"></i>{{item.system.upadd}}{{/unless}}{{#unless (eq item.system.downadd 0)}}<i class="fa-solid fa-arrow-turn-down"></i>{{item.system.downadd}}{{/unless}}{{#unless (eq item.system.charmadd 0)}}<i class="fa-regular fa-heart"></i>{{item.system.charmadd}}{{/unless}}({{item.system.singpoint}})</span>{{/if}}{{#if (eq item.system.type "final")}}<span class="notescost n-tag n-tag-cost">{{#unless (eq item.system.upcost 0)}}<i class="fa-solid fa-arrow-turn-up"></i>{{item.system.upcost}}{{/unless}}{{#unless (eq item.system.downcost 0)}}<i class="fa-solid fa-arrow-turn-down"></i>{{item.system.downcost}}{{/unless}}{{#unless (eq item.system.charmcost 0)}}<i class="fa-regular fa-heart"></i>{{item.system.charmcost}}{{/unless}}</span>{{/if}}{{/if}}{{#if (and item.system.app (ne item.system.app "-"))}}<span class="n-tag">{{item.system.app}}</span>{{/if}}{{#if (and item.system.rank (ne item.system.rank "-") (ne item.type "tactics"))}}<span class="n-tag">{{localize "SW25.Item.Rank"}} {{item.system.rank}}</span>{{/if}}{{#if (and item.system.target (ne item.system.target "-"))}}<span class="n-tag">{{item.system.target}}</span>{{/if}}{{#if (and item.system.rangeshape (ne item.system.rangeshape "-"))}}<span class="n-tag">{{item.system.rangeshape}}</span>{{/if}}{{#if (and item.system.time (ne item.system.time "-"))}}<span class="n-tag">{{item.system.time}}</span>{{/if}}{{#if (and item.system.resistname (ne item.system.resistname "-"))}}<span class="n-tag n-tag-res">{{item.system.resistname}}</span>{{/if}}{{#if (and item.system.propname (ne item.system.propname "-"))}}<span class="n-tag n-tag-prop">{{item.system.propname}}</span>{{/if}}{{#if (and item.system.support (ne item.system.support "-"))}}<span class="n-tag">{{item.system.support}}</span>{{/if}}{{#if (and item.system.rtpart (ne item.system.rtpart "-"))}}<span class="n-tag">{{item.system.rtpart}}</span>{{/if}}{{#if (and item.system.itpart (ne item.system.itpart "-"))}}<span class="n-tag">{{item.system.itpart}}</span>{{/if}}</div>
    </div>
    <div class="n-row-acts">
      {{#if (eq item.system.type "bibliomancer")}}<div class="item-equip"><label class="equip-toggle"><input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if item.system.equip}} checked {{/if}}/></label></div>{{/if}}
      {{> "systems/sw25-ru/templates/actor/parts/actor-useitems.hbs" item=item}}
      {{#if (eq item.type "alchemytech")}}<span class="n-cards"><a class="materialcardcost">B</a><a class="materialcardcost">A</a><a class="materialcardcost">S</a><a class="materialcardcost">SS</a></span>{{/if}}
      {{#if (or spell item.system.usedice item.system.usepower item.system.useeffect item.system.mpcost item.system.hpcost (eq item.type "tactics") (eq item.type "phasearea") (eq item.type "alchemytech") (eq item.type "magicalsong") (eq item.type "essenceweave"))}}<a class="rollable n-btn n-btn-use" data-roll-type="item">{{#if spell}}{{localize "SW25.NewSheet.Cast"}}{{else}}{{localize "SW25.Use"}}{{/if}}</a>{{/if}}
      <a class="changebookmark n-star{{#if item.system.bookmark}} on{{/if}}" data-tooltip="{{localize "SW25.NewSheet.Fav"}}"><i class="{{#if item.system.bookmark}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i></a>
    </div>
  </div>
  <div class="{{#if spell}}spell-description{{else}}item-description{{/if}} nogapmargin">
    <div class="n-desc">{{{item.system.description}}}</div>
    <div class="item-controls n-desc-ctl"><a class="item-control item-edit"><i class="fas fa-edit"></i></a>{{#if @root.isOwner}}<a class="item-control item-delete"><i class="fas fa-trash"></i></a>{{/if}}</div>
  </div>
</li>
{{/inline}}
<form class="{{cssClass}} {{actor.type}}" autocomplete="off">
<section class="sw25pc sw25n{{#if system.isEdit}} is-edit{{/if}}{{#if (lte system.hp.value 0)}} is-down{{/if}}">

  <header class="n-hd">
    <div class="n-side">
      <div class="n-portrait">
        {{#if system.isToken}}
          <img class="profile-img" src="{{#if token.texture.src}}{{token.texture.src}}{{else}}{{actor.prototypeToken.texture.src}}{{/if}}" title="{{actor.name}}"/>
        {{else}}
          <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
        {{/if}}
      </div>
      <div class="n-slot">
        {{#if (lte system.hp.value 0)}}
        <div class="deathcheck-row" data-tooltip="{{localize "SW25.DeathCheck.Tooltip"}}">
            <a class="deathcheckroll">
              <i class="fa-solid fa-skull-crossbones"></i> {{localize "SW25.DeathCheck.Roll"}}
            </a>
            {{!-- [Round 60] pip dots so the death-check state reads at a glance,
                 like a health track, instead of only as "3/6" text. Built from
                 context.deathcheckPips (actor-sheet.mjs) since this codebase has
                 no template-level range/loop helper. Kept the text counter too
                 for exact-number clarity. --}}
            <div class="deathcheck-status">
              <div class="deathcheck-pips">
                {{#each deathcheckPips as |pip|}}
                <span class="deathcheck-pip {{#if pip.filled}}deathcheck-pip--filled{{/if}}"></span>
                {{/each}}
              </div>
              <span class="deathcheck-counter">{{system.attributes.deathchecks.value}}/6</span>
            </div>
          </div>
        {{else}}
        <div class="n-lvl"><small>{{localize "SW25.Level"}}</small><b>{{system.attributes.advlevel.value}}</b></div>
        <div class="n-lvl"><small>{{localize "SW25.Attributes.Exp"}}</small><b>{{system.attributes.totalexp}}</b></div>
        {{/if}}
      </div>
    </div>

    <div class="n-main">
      <div class="n-namebar">
        <div class="n-nameplate">
          <div class="n-np-text">
          <section class="header__title">
      <h1 class="header__title--name">
      {{#if system.isEdit}}
        <input class="header--input" id="{{actor._id}}name" name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      {{else}}
        {{actor.name}}
      {{/if}}
      </h1>
    </section>

    <section class="header__overview">
      {{#if system.isEdit}}
        <div class="header__overview--race">
          <input class="header--input" id="{{actor._id}}race" type="text" name="system.race" value="{{system.race}}" placeholder="{{localize "SW25.Race"}}" data-dtype="String" data-tooltip="{{localize "SW25.Race"}}"/>
        </div>
        <div class="header__overview--gender">
          <input class="header--input" id="{{actor._id}}gender" type="text" name="system.attributes.gender" value="{{system.attributes.gender}}" placeholder="{{localize "SW25.Attributes.Gender"}}" data-dtype="String" data-tooltip="{{localize "SW25.Attributes.Gender"}}"/>
        </div>
        <div class="header__overview--age">
          <input class="header--input" id="{{actor._id}}age" type="number" name="system.attributes.age" value="{{system.attributes.age}}" placeholder="{{localize "SW25.Attributes.Age"}}" data-dtype="Number" data-tooltip="{{localize "SW25.Attributes.Age"}}"/>
        </div>
        <div class="header__overview--rank-input">
          <input class="header--input" id="{{actor._id}}rank" type="text" name="system.attributes.honer.rank" value="{{system.attributes.honer.rank}}" placeholder="{{localize "SW25.Attributes.Honer.Rank"}}" data-dtype="String" data-tooltip="{{localize "SW25.Attributes.Honer.Rank"}}"/>
        </div>
        <div class="header__overview--honer">
          <input class="header--input" id="{{actor._id}}honer" type="number" name="system.attributes.honer.value" value="{{system.attributes.honer.value}}" placeholder="{{localize "SW25.Attributes.Honer.Label"}}" data-dtype="Number" data-tooltip="{{localize "SW25.Attributes.Honer.Label"}}"/>
        </div>
      {{else}}
        <div class="n-ov">
          {{#if system.race}}<span>{{system.race}}</span>{{/if}}{{#if system.attributes.gender}}<span>{{system.attributes.gender}}</span>{{/if}}{{#if system.attributes.age}}<span>{{localize "SW25.Attributes.AgeLabel" age=system.attributes.age}}</span>{{/if}}{{#if system.attributes.honer.rank}}<span><i class="fa-solid fa-medal"></i> {{system.attributes.honer.rank}}</span>{{/if}}{{#if system.attributes.honer.value}}<span>{{localize "SW25.Attributes.Honer.Label"}} {{system.attributes.honer.value}}</span>{{/if}}
        </div>
      {{/if}}
    </section>
          </div>
          <div class="n-quick">
            <div class="roll-ability-check growth-button rollable"><i class="fa-solid fa-dice"></i>{{localize "SW25.Ability.Growth"}}</div>
          </div>
        </div>
        <div class="n-modes">
          <label class="n-mode" data-tooltip="{{localize "SW25.Setting"}}"><input type="checkbox" name="system.isEdit" {{#if system.isEdit}}checked{{/if}} data-dtype="Boolean"/><span><i class="fa-solid fa-wrench"></i></span></label>
          {{#if system.isEdit}}
          <label class="n-mode" data-tooltip="{{#if system.isToken}}{{localize "SW25.SwitchImage" image=(localize "SW25.ActorImage")}}{{else}}{{localize "SW25.SwitchImage" image=(localize "SW25.TokenImage")}}{{/if}}"><input type="checkbox" name="system.isToken" {{#if system.isToken}}checked{{/if}} data-dtype="Boolean"/><span><i class="fa-solid fa-circle-user"></i></span></label>
          {{/if}}
          <label class="n-mode" data-tooltip="{{localize "SW25.Attributes.Grace"}}"><input type="checkbox" name="system.attributes.grace" {{#if system.attributes.grace}}checked{{/if}} data-dtype="Boolean"/><span><i class="fa-solid fa-chess-queen"></i></span></label>
        </div>
      </div>
      <div class="n-classes">
        {{#each skills as |item id|}}<span class="n-cls">{{item.name}} <b>{{item.system.skilllevel}}</b></span>{{/each}}
      </div>
      <div class="n-vitals">
<div class="hpbar">
            <div class="hp-progress-bar"><span class="n-vlab">{{localize "SW25.Hp"}}</span>
              <progress class="hp-bar grid-span-3" value="{{system.hp.value}}" max="{{system.hp.max}}"></progress>
              {{#if system.isEdit}}
                <div class="current-max-resource nobreak" style="font-size:0.8em">
                  <span class="inline-block">{{system.hp.max}} + </span>
                  <input id="{{actor._id}}hpmod" type="number" name="system.hp.hpmod" value="{{system.hp.hpmod}}" data-dtype="Number"/>
                  <i class="fa-solid fa-angles-up"></i>
                </div>
              {{else}}
                <div class="current-max-resource nobreak">
                  <input id="{{actor._id}}hp" type="number" name="system.hp.value" value="{{system.hp.value}}" data-dtype="Number"/>
                  <span class="inline-block">/ {{system.hp.max}}</span>
                </div>
              {{/if}}
            </div>
          </div>
          <div class="mpbar">
            <div class="mp-progress-bar"><span class="n-vlab">{{localize "SW25.Mp"}}</span>
              <progress class="mp-bar grid-span-3" value="{{system.mp.value}}" max="{{system.mp.max}}"></progress>
              {{#if system.isEdit}}
                <div class="current-max-resource nobreak" style="font-size:0.8em">
                  <span class="inline-block">{{system.mp.max}} + </span>
                  <input id="{{actor._id}}mpmod" type="number" name="system.mp.mpmod" value="{{system.mp.mpmod}}" data-dtype="Number"/>
                  <i class="fa-solid fa-angles-up"></i>
                </div>
              {{else}}
                <div class="current-max-resource nobreak">
                  <input id="{{actor._id}}mp" type="number" name="system.mp.value" value="{{system.mp.value}}" data-dtype="Number"/>
                  <span class="inline-block">/ {{system.mp.max}}</span>
                </div>
              {{/if}}
            </div>
          </div>
          
      </div>
    </div>
  </header>

  <div class="n-tiles">
    <div class="n-tile">
      <div class="n-tile-main"><b>{{system.attributes.protectionpoint}}</b><span>{{localize "SW25.Attributes.Protectionpoint.long"}}</span></div>
      <details class="n-more"><summary>{{localize "SW25.Details"}}</summary><div class="n-pop">
        <dl>{{#each armors as |item id|}}{{#if item.system.equip}}<dt>{{item.name}}</dt><dd>{{item.system.pp}}</dd>{{/if}}{{/each}}
          <dt>{{localize "SW25.Effects"}}</dt><dd>{{system.attributes.efppmod}}</dd>
          <dt>{{localize "SW25.Effect.Dreduce"}}</dt><dd>{{system.baredreduce}}</dd></dl>
        <label class="n-adj"><span>{{localize "SW25.Effect.PpMod"}}</span><input type="text" name="system.attributes.ppmod" value="{{system.attributes.ppmod}}" data-dtype="Number"/></label>
      </div></details>
    </div>
    <div class="n-tile">
      <div class="n-tile-main"><b>{{system.attributes.magicprotection}}</b><span>{{localize "SW25.Attributes.Magicprotection.long"}}</span></div>
      <details class="n-more"><summary>{{localize "SW25.Details"}}</summary><div class="n-pop">
        <dl>{{#each armors as |item id|}}{{#if item.system.equip}}{{#if item.system.mpp}}<dt>{{item.name}}</dt><dd>{{item.system.mpp}}</dd>{{/if}}{{/if}}{{/each}}
          <dt>{{localize "SW25.Effects"}}</dt><dd>{{system.attributes.efmppmod}}</dd>
          <dt>{{localize "SW25.Effect.Dreduce"}}</dt><dd>{{system.baredreduce}}</dd></dl>
        <label class="n-adj"><span>{{localize "SW25.Effect.MppMod"}}</span><input type="text" name="system.attributes.mppmod" value="{{system.attributes.mppmod}}" data-dtype="Number"/></label>
      </div></details>
    </div>
    <div class="n-tile n-roll">
      <span class="rollable n-tile-main" data-roll="2d6+{{system.dodgebase}}" data-label="{{localize "SW25.Item.Armor.Dodge"}}" data-pt=""><b>{{system.dodgebase}}</b><span>{{localize "SW25.Resist.Check.Dodge"}}</span></span>
      <details class="n-more"><summary>{{localize "SW25.Details"}}</summary><div class="n-pop">
        <dl><dt>{{system.dodgeskill}}</dt><dd>{{system.skillagidodge}}</dd>
          <dt>{{localize "SW25.Equip"}}</dt><dd>{{system.itemdodge}}</dd>
          <dt>{{localize "SW25.Effect.DodgeMod"}}</dt><dd>{{system.attributes.dodgemod}}</dd>
          <dt>{{localize "SW25.Effects"}}</dt><dd>{{system.attributes.efdodgemod}}</dd></dl>
      </div></details>
    </div>
    {{#if contentItem.vitRes}}{{#with contentItem.vitRes as |item|}}
      <div class="n-tile n-roll item" data-item-id="{{item._id}}">
        <span class="rollable n-tile-main" data-roll="{{item.system.formula}}+{{item.system.checkbase}}" data-label="{{item.name}}" data-pt="{{item.system.powertable}}" data-apply="{{item.system.applycheck}}" data-checktype="{{item.system.checkTypesButton}}"><b>{{item.system.checkbase}}</b><span>{{localize "SW25.Config.ResVit"}}</span></span>
        <details class="n-more"><summary>{{localize "SW25.Modifier"}}</summary><div class="n-pop">
          <label class="n-adj"><span>{{localize "SW25.Config.ResVit"}}{{localize "SW25.Modifier"}}</span><input class="cm-change" type="text" name="checkmodInput" value="{{item.system.checkmod}}" data-dtype="Number"/></label>
        </div></details>
      </div>
      {{/with}}{{else}}
      <div class="n-tile"><div class="n-tile-main"><b>–</b><span>{{localize "SW25.Config.ResVit"}}</span></div></div>
      {{/if}}
    {{#if contentItem.mndRes}}{{#with contentItem.mndRes as |item|}}
      <div class="n-tile n-roll item" data-item-id="{{item._id}}">
        <span class="rollable n-tile-main" data-roll="{{item.system.formula}}+{{item.system.checkbase}}" data-label="{{item.name}}" data-pt="{{item.system.powertable}}" data-apply="{{item.system.applycheck}}" data-checktype="{{item.system.checkTypesButton}}"><b>{{item.system.checkbase}}</b><span>{{localize "SW25.Config.ResMnd"}}</span></span>
        <details class="n-more"><summary>{{localize "SW25.Modifier"}}</summary><div class="n-pop">
          <label class="n-adj"><span>{{localize "SW25.Config.ResMnd"}}{{localize "SW25.Modifier"}}</span><input class="cm-change" type="text" name="checkmodInput" value="{{item.system.checkmod}}" data-dtype="Number"/></label>
        </div></details>
      </div>
      {{/with}}{{else}}
      <div class="n-tile"><div class="n-tile-main"><b>–</b><span>{{localize "SW25.Config.ResMnd"}}</span></div></div>
      {{/if}}
    <div class="n-tile">
      <div class="n-tile-main"><b>{{system.attributes.move.normal}}</b><span>{{localize "SW25.Attributes.Move"}}</span></div>
      <details class="n-more"><summary>{{localize "SW25.Details"}}</summary><div class="n-pop">
        <dl><dt>{{localize "SW25.Attributes.Limitedmove"}}</dt><dd>{{system.attributes.move.limited}}</dd>
          <dt>{{localize "SW25.Attributes.Normalmove"}}</dt><dd>{{system.attributes.move.normal}}</dd>
          <dt>{{localize "SW25.Attributes.Maxmove"}}</dt><dd>{{system.attributes.move.max}}</dd></dl>
        <label class="n-adj"><span>{{localize "SW25.Attributes.Movemod"}}</span><input type="text" name="system.attributes.move.movemod" value="{{system.attributes.move.movemod}}" data-dtype="Number"/></label>
      </div></details>
    </div>
    <div class="n-tile n-fumble">
      <div class="property-col">
        <label class="property--label-col" for="{{actor._id}}fumble" class="resource-label">{{localize "SW25.Attributes.Fumble"}}</label>
        <div class="property--value adjustable-container">
          <a class="adjustment-button" data-action="decrease" data-property="system.attributes.fumble">
            <i class="fas fa-minus"></i>
          </a>
          <input class="textcolor-main" id="{{actor._id}}fumble" type="number" name="system.attributes.fumble" value="{{system.attributes.fumble}}" data-dtype="Number"/>
          <a class="adjustment-button" data-action="increase" data-property="system.attributes.fumble">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="n-abil">
    {{#each system.abilities as |ability key|}}
    <div class="n-ab"><span>{{ability.label}}</span><i>{{ability.value}}</i><b>{{numberFormat ability.mod decimals=0 sign=true}}</b></div>
    {{/each}}
  </div>

  <div class="n-fx">
    <small>{{localize "SW25.Effects"}}</small>
    {{#each effects as |section sid|}}{{#if (eq section.type "temporary")}}{{#each section.effects as |effect|}}
    <span class="n-chip" data-tooltip="{{#if effect.flags.sw25.sourceName}}{{effect.flags.sw25.sourceName}}{{else}}{{effect.parent.name}}{{/if}}"><img src="{{effect.img}}" alt=""/>{{effect.name}}{{#if (or effect.duration.rounds effect.duration.seconds effect.duration.turns)}}<i>{{effect.duration.label}}</i>{{/if}}</span>
    {{/each}}{{/if}}{{/each}}
    {{#each system.modParams}}<span class="n-chip n-chip-mod">{{label}}: {{value}}</span>{{/each}}
  </div>

  <nav class="n-tabs sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="battle">{{localize "SW25.Battle"}}</a>
    <a class="item" data-tab="check">{{localize "SW25.Check"}}</a>
    <a class="item" data-tab="features">{{localize "SW25.Features"}}</a>
    <a class="item" data-tab="spells">{{localize "SW25.Spells"}}</a>
    <a class="item" data-tab="items">{{localize "SW25.Items"}}</a>
    <a class="item" data-tab="effects">{{localize "SW25.Effects"}}</a>
    <a class="item" data-tab="description">{{localize "SW25.Description"}}</a>
  </nav>

  <section class="sheet-body n-body" data-scrollable="true" id="main-contents">

